{
    "expo": {
        "name": "StrainNative",
        "slug": "StrainNative",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "strainnative",
        "userInterfaceStyle": "dark",
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.ervinnn.StrainNative",
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false
            }
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#000000"
            },
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            [
                "expo-splash-screen",
                {
                    "image": "./assets/splash-icon.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#000000"
                }
            ],
            "expo-router",
            "expo-secure-store",
            "@react-native-community/datetimepicker",
            "expo-font",
            "expo-status-bar",
            "expo-web-browser"
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "34e9d980-c3b5-4295-abcd-a32d9bb38c62"
            }
        }
    }
}
